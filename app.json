{
  "expo": {
    "name": "Conductor Pro Chile",
    "slug": "driver-pro-cl",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "conductor-pro",
    "userInterfaceStyle": "dark",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0B0F17"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.conductorpro.chile"
    },
    "android": {
      "package": "com.conductorpro.chile"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
